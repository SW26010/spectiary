+// Keep invalid numeric edits out of the axis setters, which normalize NaN to 0.
+static bool DragAxisLimit(const char* label, double* value, float speed, double min, double max) {
+    ImGui::PushID(label);
+    const ImGuiID error_id = ImGui::GetID("##NonFiniteRange");
+    ImGui::PopID();
+    double candidate = *value;
+    const bool changed = DragFloat(label, &candidate, speed, min, max);
+    const bool valid = !ImNanOrInf(candidate);
+    // TempInputScalar returns false for a valid edit equal to the old value.
+    // Only clear on successfully parsed text, not activation or arbitrary edits.
+    ImGuiInputTextState* input = ImGui::GetInputTextState(ImGui::GetItemID());
+    bool valid_text_edit = false;
+    if (input != nullptr && input->EditedThisFrame) {
+        const char* text = input->GetText();
+        char* end = nullptr;
+        const double parsed = strtod(text, &end);
+        const bool parsed_number = end != text;
+        while (ImCharIsBlankA(*end))
+            ++end;
+        valid_text_edit = parsed_number && *end == 0 && !ImNanOrInf(parsed);
+    }
+    if (changed || valid_text_edit)
+        ImGui::GetStateStorage()->SetBool(error_id, !valid);
+    if (ImGui::GetStateStorage()->GetBool(error_id))
+        ImGui::TextUnformatted("Range limit must be finite; previous value kept.");
+    if (changed && valid)
+        *value = candidate;
+    return changed && valid;
+}
