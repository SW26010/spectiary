{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "SPECFORGE_BUILD_SOURCE_MODE": "working_tree",
        "SPECFORGE_BUILD_SOURCE_REVISION": ""
      }
    },
    {
      "name": "dynamic-deps-base",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "portable-profile",
      "hidden": true,
      "cacheVariables": {
        "SPECFORGE_RELEASE_PROFILE": "Portable"
      }
    },
    {
      "name": "installed-profile",
      "hidden": true,
      "cacheVariables": {
        "SPECFORGE_RELEASE_PROFILE": "Installed"
      }
    },
    {
      "name": "static-release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "SPECFORGE_EMBED_PUBLIC_SPECTRAL_LINES": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "vs2022-x64-portable-debug",
      "displayName": "Visual Studio 2022 x64 Portable Debug",
      "inherits": [
        "base",
        "dynamic-deps-base",
        "portable-profile"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "vs2022-x64-installed-debug",
      "displayName": "Visual Studio 2022 x64 Installed Debug",
      "inherits": [
        "base",
        "dynamic-deps-base",
        "installed-profile"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "vs2022-x64-portable-release-static",
      "displayName": "Visual Studio 2022 x64 Portable Static Release",
      "inherits": [
        "base",
        "portable-profile",
        "static-release-base"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "ninja-msvc-portable-debug",
      "displayName": "Ninja MSVC Portable Debug",
      "inherits": [
        "base",
        "dynamic-deps-base",
        "portable-profile"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-msvc-installed-debug",
      "displayName": "Ninja MSVC Installed Debug",
      "inherits": [
        "base",
        "dynamic-deps-base",
        "installed-profile"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-msvc-portable-release-static",
      "displayName": "Ninja MSVC Portable Static Release",
      "inherits": [
        "base",
        "portable-profile",
        "static-release-base"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-x64-portable-debug",
      "configurePreset": "vs2022-x64-portable-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x64-installed-debug",
      "configurePreset": "vs2022-x64-installed-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x64-portable-release-static",
      "configurePreset": "vs2022-x64-portable-release-static",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-portable-debug",
      "configurePreset": "ninja-msvc-portable-debug"
    },
    {
      "name": "ninja-msvc-installed-debug",
      "configurePreset": "ninja-msvc-installed-debug"
    },
    {
      "name": "ninja-msvc-portable-release-static",
      "configurePreset": "ninja-msvc-portable-release-static"
    }
  ]
}
